# GEMINI_API_KEY: Required for Gemini AI API calls (Script Generation, Keyword Extraction, and Text-to-Speech).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# POLLINATIONS_API_KEY: Optional API key (sk_...) for Pollinations AI native video models (gen.pollinations.ai/video/*).
# Enable Paid Pollen on your key at enter.pollinations.ai for native Wan/Seedance/Veo clips; Quest/free tier automatically renders multi-shot 25fps camera motion + xfade transitions.
POLLINATIONS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
